# Required: your CapSolver client key (https://dashboard.capsolver.com)
CAPSOLVER_API_KEY=

# Optional: developer appId (dashboard -> developer section)
CAPSOLVER_APP_ID=

# Optional: primary API host. Server-B (https://api-stable.capsolver.com) is used as fallback.
CAPSOLVER_API_URL=https://api.capsolver.com

# Polling: interval between getTaskResult calls and total timeout (ms)
CAPSOLVER_POLL_INTERVAL_MS=2000
CAPSOLVER_TIMEOUT_MS=120000

# Optional default proxy for non-ProxyLess tasks.
# Formats: ip:port:user:pass  |  http://user:pass@ip:port  |  socks5://ip:port
CAPSOLVER_PROXY=

# Headless Chrome
HEADLESS=true
# Leave empty to use the Chrome bundled with puppeteer
CHROME_EXECUTABLE_PATH=

# --- worldofnations module ---
WON_EMAIL=
WON_PASSWORD=
WON_USERNAME=
